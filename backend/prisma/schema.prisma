generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  projects  Project[]
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String?
  name           String
  role           String         @default("DEVELOPER") // ADMIN, DEVELOPER, APPROVER
  firebaseUid    String?        @unique
  provider       String?        @default("email")
  avatarUrl      String?
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  notifications  Notification[]
}

model Project {
  id              String       @id @default(cuid())
  name            String
  rootPath        String
  runtimeType     String
  healthCheckUrl  String?
  composeFile     String?
  testCommand     String?
  restartCommand  String?
  gitUrl          String?
  serverHost      String?
  serverPort      Int?         @default(22)
  serverUser      String?
  environmentType String?      @default("Docker Compose")
  organizationId  String?
  userId          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  incidents       Incident[]
  repositories    Repository[]
}

model Incident {
  id              String          @id
  projectId       String
  title           String
  userPrompt      String
  scenarioKey     String?
  status          String
  severity        String?
  affectedService String?
  confidence      Float?
  rootCause       String?
  report          String?
  startedAt       DateTime        @default(now())
  resolvedAt      DateTime?
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events          IncidentEvent[]
  approvals       Approval[]
}

model IncidentEvent {
  id         String   @id
  incidentId String
  type       String
  title      String
  details    String?  // Stored as JSON string
  status     String?
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Approval {
  id         String    @id
  incidentId String
  actionType String
  title      String?
  description String?
  commands   String?   // Stored as JSON string
  riskLevel  String
  status     String
  diff       String?
  rollbackPlan String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Repository {
  id            String           @id @default(cuid())
  projectId     String?
  name          String
  url           String?
  localPath     String?
  defaultBranch String?          @default("main")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scans         RepositoryScan[]
}

model RepositoryScan {
  id                   String              @id
  repositoryId         String
  status               String
  overallScore         Int
  securityScore        Int
  qualityScore         Int
  testingScore         Int
  reliabilityScore     Int
  documentationScore   Int
  maintainabilityScore Int
  summary              String
  startedAt            DateTime            @default(now())
  completedAt          DateTime?
  repository           Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings             RepositoryFinding[]
}

model RepositoryFinding {
  id             String         @id
  scanId         String
  severity       String
  category       String
  title          String
  filePath       String?
  line           Int?
  impact         String
  recommendation String
  patch          String?
  status         String         @default("OPEN")
  createdAt      DateTime       @default(now())
  scan           RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

// ─── Phase 8: Enterprise Features ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  type      String   // success | warning | danger | info
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  userEmail String?
  userName  String?
  action    String
  category  String   // AUTH | INCIDENT | APPROVAL | SCAN | CODE_PATCH | SYSTEM
  target    String
  ipAddress String?
  status    String   // SUCCESS | WARNING | FAILED
  details   String?
  createdAt DateTime @default(now())
}
