# ============================================================
# D-OpsPilot AI — Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git — it's already in .gitignore
# ============================================================

# Server Port
PORT=5080

# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=postgresql://opspilot:YOUR_DB_PASSWORD@localhost:5432/opspilot
# For local SQLite dev: DATABASE_URL="file:./dev.db"

# PostgreSQL Docker credentials (used by docker-compose)
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD
POSTGRES_DB=opspilot

# JWT Secret — generate a strong random string (min 32 chars)
# e.g. openssl rand -hex 32
JWT_SECRET=YOUR_STRONG_JWT_SECRET_HERE

# OpenAI API Key — from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o
